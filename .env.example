# Backend origin, without a trailing slash. The client appends /api itself.
VITE_API_BASE_URL=http://localhost:8080

# Socket.IO origin. Usually the same host as the API.
VITE_SOCKET_URL=http://localhost:8080

# --- Document uploads --------------------------------------------------------
# Cloudinary unsigned upload preset. NOTE: files uploaded this way are publicly
# readable by anyone holding the URL — which includes RC books, insurance
# certificates and permits. Moving to signed uploads with authenticated
# delivery is still outstanding.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
